<resources>
    <string name="app_name">पवित्र मंदिर</string>
    <string name="app_tagline">दैनिक पावन उपासना एवं साधना स्थल</string>

    <!-- Purity Gate -->
    <string name="purity_gate_title">शुद्धि संकल्प</string>
    <string name="purity_question">क्या आपने स्नान कर शुद्धि प्राप्त कर ली है?</string>
    <string name="purity_subtitle">मंदिर में प्रवेश करने से पूर्व तन और मन की पवित्रता अनिवार्य है।</string>
    <string name="purity_confirm_btn">हाँ, मैं शुद्ध हूँ</string>
    <string name="snan_mantra_btn">स्नान मंत्र सुनें</string>
    <string name="snan_mantra_text">गङ्गे च यमुने चैव गोदावरि सरस्वति। नर्मदे सिन्धु कावेरि जलेऽस्मिन् संनिधिं कुरु॥</string>

    <!-- Cleaning -->
    <string name="cleaning_title">मंदिर शुद्धि एवं सफाई</string>
    <string name="cleaning_status_dusty">मंदिर में धूल एकत्रित हो गई है एवं पुष्प निर्माल्य हो चुके हैं।</string>
    <string name="cleaning_step_flowers">1. बासी पुष्पों को उठाकर निर्माल्य पात्र में रखें</string>
    <string name="cleaning_step_wipe">2. गीले वस्त्र से मंदिर की चौकी को पोंछें</string>
    <string name="cleaning_step_diya">3. दीपक को धोकर स्वच्छ करें</string>
    <string name="cleaning_complete">मंदिर पूर्ण रूप से स्वच्छ व पावन हो चुका है।</string>
    <string name="nirmalya_patra">निर्माल्य पात्र (विसर्जन हेतु)</string>
    <string name="action_clean">सफाई करें</string>

    <!-- Deities -->
    <string name="deity_ganesh">भगवान श्री गणेश</string>
    <string name="deity_ganesh_desc">विघ्नहर्ता, प्रथम पूज्य, रिद्धि-सिद्धि दाता</string>
    <string name="deity_lakshmi">माता महालक्ष्मी</string>
    <string name="deity_lakshmi_desc">धन-धान्य, ऐश्वर्य व सौभाग्य प्रदायिनी</string>

    <!-- Completion -->
    <string name="completion_title">पूजा संपन्न हुई!</string>
    <string name="completion_blessing">भगवान श्री गणेश और माता लक्ष्मी आपके घर में सुख, शांति और समृद्धि का वास करें।</string>
    <string name="streak_label">नित्य उपासना निरंतरता</string>
    <string name="days">दिन</string>
    <string name="close_mandir_evening">संध्या पट बंद करें</string>
