{
  "uid": "worship-api",
  "title": "Worship API",
  "tags": ["worship", "backend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Requests per second by route", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "worship-prometheus"},
      "targets": [{"expr": "sum by (route,method) (rate(worship_http_requests_total[5m]))", "legendFormat": "{{method}} {{route}}", "refId": "A"}]
    },
    {
      "id": 2, "title": "P95 API time by route", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "datasource": {"type": "prometheus", "uid": "worship-prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le,route) (rate(worship_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}]
    },
    {
      "id": 3, "title": "HTTP errors by status", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "worship-prometheus"},
      "targets": [{"expr": "sum by (status,route) (increase(worship_http_requests_total{status=~\"4..|5..\"}[5m]))", "legendFormat": "{{status}} {{route}}", "refId": "A"}]
    },
    {
      "id": 4, "title": "API scrape health", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "worship-prometheus"},
      "targets": [{"expr": "up{job=\"worship-api\"}", "legendFormat": "API up", "refId": "A"}]
    }
  ]
}
