# Use a long random value; do not commit deploy/.env.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
API_PORT=8080
GRAFANA_PORT=3000
# Keep false for deployment. True permits the fixed demo OTP and mock payments.
MOCK_MODE=false
# To enable email notifications, create alertmanager.local.yml from the example.
# ALERTMANAGER_CONFIG=./alertmanager.local.yml

# Set OTP_PROVIDER=fast2sms for Smart OTP, or twilio. Keep MOCK_MODE=false.
OTP_PROVIDER=
# Fast2SMS: set the WhatsApp channel in the Smart OTP dashboard.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
# Twilio only:
OTP_CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Google login: Web OAuth client ID (same as Android googleClientId property).
GOOGLE_CLIENT_ID=653836355193-vvbqtr7f50p3ct29c3id30pt8doak8is.apps.googleusercontent.com
